#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run gitleaks to prevent committing secrets
echo "🔒 Running gitleaks to check for secrets..."

# Check if gitleaks is installed
if ! command -v gitleaks &> /dev/null; then
    echo "⚠️  gitleaks is not installed. Installing..."
    echo "Please run: npm install --save-dev gitleaks OR brew install gitleaks"
    echo "Skipping secret scan for now..."
    exit 0
fi

# Run gitleaks
if gitleaks protect --verbose --redact --staged; then
    echo "✅ No secrets detected"
else
    echo "❌ SECRETS DETECTED! Commit blocked."
    echo ""
    echo "To fix:"
    echo "  1. Remove the secret from your code"
    echo "  2. Add it to .env file (already in .gitignore)"
    echo "  3. Use environment variables instead"
    echo ""
    echo "If this is a false positive, update .gitleaks.toml"
    exit 1
fi
