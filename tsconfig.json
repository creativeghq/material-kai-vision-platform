{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Reuse the previous run's dependency graph. tsc tracks file versions itself, so an
       incremental run is as sound as a cold one; the cache lives under node_modules so a
       clean checkout (CI) pays the cold cost once and nothing is committed. */
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/main.tsbuildinfo",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Additional options */
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "src/types/global.d.ts",
    "src/types/modules.d.ts",
    "src/types/jsx.d.ts",
    "vite.config.ts",
    "vite.embed.config.ts",
    "tailwind.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".ruru",
    "scripts",
    "supabase/**"
  ]
}
