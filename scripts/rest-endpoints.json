{
  "tag": "Banking (database)",
  "resources": [
    {
      "name": "vw_bank_account_balances",
      "kind": "view",
      "summary": "Business bank accounts with their current balance",
      "description": "One row per finance_bank_accounts row, with the balance DERIVED from the ledger: current_balance = opening_balance + Σ payments in − Σ payments out booked to that account. `security_invoker` view, so RLS on the underlying tables decides what you see — only accounts in workspaces you are a member of. This is the platform's BOOK balance; the balance the bank itself reports comes from POST /revolut-api {action:\"accounts\"} (Revolut-connected workspaces only).",
      "docs": "docs/banking-revolut.md",
      "methods": [
        "GET"
      ],
      "example": "/rest/v1/vw_bank_account_balances?workspace_id=eq.<uuid>&is_active=eq.true&order=sort_order",
      "filters": [
        "workspace_id",
        "bank_account_id",
        "is_active",
        "currency",
        "kind"
      ],
      "columns": [
        {
          "name": "bank_account_id",
          "type": "uuid",
          "nullable": true,
          "description": "finance_bank_accounts.id"
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "name",
          "type": "text",
          "nullable": true
        },
        {
          "name": "kind",
          "type": "text",
          "nullable": true,
          "enum": [
            "bank",
            "cash",
            "card",
            "online",
            "other"
          ]
        },
        {
          "name": "currency",
          "type": "text",
          "nullable": true
        },
        {
          "name": "iban",
          "type": "text",
          "nullable": true
        },
        {
          "name": "account_ref",
          "type": "text",
          "nullable": true,
          "description": "BIC / SWIFT or a free account reference"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "nullable": true
        },
        {
          "name": "is_default",
          "type": "boolean",
          "nullable": true
        },
        {
          "name": "sort_order",
          "type": "integer",
          "nullable": true
        },
        {
          "name": "opening_balance",
          "type": "numeric",
          "nullable": true,
          "description": "The balance the account held before the first payment the platform recorded against it"
        },
        {
          "name": "total_in",
          "type": "numeric",
          "nullable": true,
          "description": "Sum of payments with direction=in booked to this account"
        },
        {
          "name": "total_out",
          "type": "numeric",
          "nullable": true,
          "description": "Sum of payments with direction=out booked to this account"
        },
        {
          "name": "current_balance",
          "type": "numeric",
          "nullable": true,
          "description": "opening_balance + total_in − total_out. The BOOK balance — what the ledger says, not what the bank reports (for that, POST /revolut-api {action:\"accounts\"})"
        },
        {
          "name": "payment_count",
          "type": "bigint",
          "nullable": true,
          "description": "Payments booked to this account"
        },
        {
          "name": "show_on_invoice",
          "type": "boolean",
          "nullable": true
        },
        {
          "name": "payout_provider",
          "type": "text",
          "nullable": true,
          "enum": [
            "revolut",
            "viva"
          ],
          "description": "The rail this account can SEND money on: revolut (revolut_account_id set), viva (viva_wallet_id set), or null"
        }
      ]
    },
    {
      "name": "finance_bank_accounts",
      "kind": "table",
      "summary": "The workspace's own bank, cash and card accounts (no balance — see vw_bank_account_balances)",
      "description": "The accounts money moves through: bank accounts, cash boxes, cards, online wallets. Holds identity and settings only; the balance is derived in vw_bank_account_balances. Only one row per workspace should have is_default=true — clear the old default before setting a new one. Linking a row to a Revolut pocket is done by POST /revolut-api {action:\"map-account\"}, not by writing revolut_account_id here.",
      "docs": "docs/banking-revolut.md",
      "methods": [
        "GET",
        "POST",
        "PATCH",
        "DELETE"
      ],
      "filters": [
        "workspace_id",
        "id",
        "is_active",
        "is_default",
        "currency",
        "kind",
        "revolut_account_id"
      ],
      "writable": [
        "workspace_id",
        "name",
        "kind",
        "currency",
        "iban",
        "account_ref",
        "opening_balance",
        "is_default",
        "is_active",
        "sort_order",
        "notes",
        "show_on_invoice",
        "feed_kind"
      ],
      "required": [
        "workspace_id",
        "name"
      ],
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "name",
          "type": "text",
          "nullable": false
        },
        {
          "name": "kind",
          "type": "text",
          "nullable": false,
          "enum": [
            "bank",
            "cash",
            "card",
            "online",
            "other"
          ]
        },
        {
          "name": "currency",
          "type": "text",
          "nullable": false
        },
        {
          "name": "iban",
          "type": "text",
          "nullable": true
        },
        {
          "name": "account_ref",
          "type": "text",
          "nullable": true,
          "description": "BIC / SWIFT or a free account reference"
        },
        {
          "name": "opening_balance",
          "type": "numeric",
          "nullable": false
        },
        {
          "name": "is_default",
          "type": "boolean",
          "nullable": false
        },
        {
          "name": "is_active",
          "type": "boolean",
          "nullable": false
        },
        {
          "name": "sort_order",
          "type": "integer",
          "nullable": false
        },
        {
          "name": "notes",
          "type": "text",
          "nullable": true
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false
        },
        {
          "name": "updated_at",
          "type": "timestamp with time zone",
          "nullable": false
        },
        {
          "name": "show_on_invoice",
          "type": "boolean",
          "nullable": false
        },
        {
          "name": "revolut_account_id",
          "type": "text",
          "nullable": true,
          "description": "Revolut account (currency pocket) this row is linked to; set by POST /revolut-api {action:\"map-account\"}"
        },
        {
          "name": "provider_slug",
          "type": "text",
          "nullable": true
        },
        {
          "name": "viva_wallet_id",
          "type": "bigint",
          "nullable": true,
          "description": "Viva walletId this books account maps to (GET /merchants/v1/wallets). Required before money can be sent FROM it, the same way revolut_account_id is for Revolut."
        },
        {
          "name": "feed_kind",
          "type": "text",
          "nullable": false,
          "enum": [
            "bank_account",
            "merchant_settlement",
            "none"
          ],
          "description": "What arriving feed rows for this account MEAN. bank_account = unattributed money to reconcile against open invoices. merchant_settlement = a mirror of payments a provider webhook already settled; matching one would double-book. none = no feed."
        }
      ]
    },
    {
      "name": "revolut_bank_transactions",
      "kind": "table",
      "summary": "The bank feed — one row per transaction LEG, with its reconciliation status",
      "description": "Written by revolut-sync / revolut-webhooks (and informational stripe / viva mirrors). The feed is per-LEG: an internal move between two of your own pockets is two legs, and neither is money from a customer. Read-only through this API — match, ignore and settle lines with the /revolut-api actions reconcile, confirm-match, confirm-bill-match, confirm-plan-match and ignore-transaction.",
      "docs": "docs/banking-revolut.md",
      "methods": [
        "GET"
      ],
      "example": "/rest/v1/revolut_bank_transactions?workspace_id=eq.<uuid>&match_status=eq.unmatched&order=booked_at.desc&limit=50",
      "filters": [
        "workspace_id",
        "bank_account_id",
        "direction",
        "match_status",
        "provider",
        "booked_at"
      ],
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "bank_account_id",
          "type": "uuid",
          "nullable": true,
          "description": "finance_bank_accounts row the pocket is mapped to"
        },
        {
          "name": "revolut_account_id",
          "type": "text",
          "nullable": false
        },
        {
          "name": "provider_ref",
          "type": "text",
          "nullable": false,
          "description": "'<transaction_id>:<leg_id>' — unique per workspace + provider"
        },
        {
          "name": "transaction_id",
          "type": "text",
          "nullable": false
        },
        {
          "name": "leg_id",
          "type": "text",
          "nullable": true
        },
        {
          "name": "state",
          "type": "text",
          "nullable": false,
          "description": "Provider state (pending, completed, declined, reverted…)"
        },
        {
          "name": "type",
          "type": "text",
          "nullable": true
        },
        {
          "name": "direction",
          "type": "text",
          "nullable": true,
          "enum": [
            "in",
            "out"
          ]
        },
        {
          "name": "amount",
          "type": "numeric",
          "nullable": false,
          "description": "Always positive; direction carries the sign"
        },
        {
          "name": "currency",
          "type": "text",
          "nullable": false
        },
        {
          "name": "booked_at",
          "type": "timestamp with time zone",
          "nullable": true
        },
        {
          "name": "counterparty_name",
          "type": "text",
          "nullable": true
        },
        {
          "name": "reference",
          "type": "text",
          "nullable": true
        },
        {
          "name": "reconciled_payment_id",
          "type": "uuid",
          "nullable": true,
          "description": "payments.id created when the line was settled"
        },
        {
          "name": "raw",
          "type": "jsonb",
          "nullable": true,
          "description": "The provider payload as received"
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false
        },
        {
          "name": "updated_at",
          "type": "timestamp with time zone",
          "nullable": false
        },
        {
          "name": "match_status",
          "type": "text",
          "nullable": false,
          "enum": [
            "unmatched",
            "suggested",
            "matched",
            "ignored"
          ]
        },
        {
          "name": "matched_invoice_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "suggested_invoice_ids",
          "type": "jsonb",
          "nullable": true
        },
        {
          "name": "match_method",
          "type": "text",
          "nullable": true,
          "enum": [
            "reference",
            "amount_name",
            "manual",
            "already_recorded"
          ],
          "description": "How the line was matched: reference (bill/invoice number quoted) · amount_name · manual (a human picked the document) · already_recorded (the payment was on our books before the line arrived — bound, never re-allocated)."
        },
        {
          "name": "matched_at",
          "type": "timestamp with time zone",
          "nullable": true
        },
        {
          "name": "unmatched_notified_at",
          "type": "timestamp with time zone",
          "nullable": true
        },
        {
          "name": "spend_notified_at",
          "type": "timestamp with time zone",
          "nullable": true
        },
        {
          "name": "provider",
          "type": "text",
          "nullable": false,
          "enum": [
            "revolut",
            "stripe",
            "viva"
          ],
          "description": "revolut rows are the bank feed; stripe / viva rows are informational mirrors of money their own webhooks already settled and cannot be matched"
        },
        {
          "name": "legs_total",
          "type": "integer",
          "nullable": true,
          "description": "How many legs the parent Revolut transaction had. Fewer rows than this means the picture is incomplete — never auto-match. NULL on rows written before this column existed."
        }
      ]
    },
