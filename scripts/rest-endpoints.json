        },
        {
          "name": "invoice_id",
          "type": "uuid",
          "nullable": true,
          "description": "Exactly one of invoice_id / supplier_bill_id / order_id / credit_release_id is the TARGET"
        },
        {
          "name": "supplier_bill_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "amount",
          "type": "numeric",
          "nullable": false
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false
        },
        {
          "name": "credit_note_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "amount_doc_currency",
          "type": "numeric",
          "nullable": true
        },
        {
          "name": "fx_rate",
          "type": "numeric",
          "nullable": false
        },
        {
          "name": "realized_fx_gain_loss",
          "type": "numeric",
          "nullable": false
        },
        {
          "name": "supplier_credit_note_id",
          "type": "uuid",
          "nullable": true,
          "description": "SOURCE (not target): the supplier credit note relieving the supplier_bill_id on this row. Mirrors credit_note_id relieving an invoice."
        },
        {
          "name": "order_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "credit_release_id",
          "type": "uuid",
          "nullable": true
        }
      ]
