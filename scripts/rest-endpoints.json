    {
      "name": "payout_instructions",
      "kind": "table",
      "summary": "Audit trail of every money-out instruction sent to a bank",
      "description": "One row per payment, draft, payout link or FX exchange the platform instructed, written with its idempotent request_id BEFORE the provider is called. Read-only; created by /revolut-api send-payment, pay-due-bills, create-payout-link and exchange.",
      "docs": "docs/banking-revolut.md",
      "methods": [
        "GET"
      ],
      "filters": [
        "workspace_id",
        "kind",
        "state",
        "provider",
        "supplier_bill_id"
      ],
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "workspace_id",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "request_id",
          "type": "text",
          "nullable": false,
          "description": "Idempotency key, written BEFORE the provider is called"
        },
        {
          "name": "kind",
          "type": "text",
          "nullable": false,
          "enum": [
            "draft",
            "payment",
            "payout_link",
            "exchange"
          ]
        },
        {
          "name": "state",
          "type": "text",
          "nullable": false
        },
        {
          "name": "amount",
          "type": "numeric",
          "nullable": false
        },
        {
          "name": "currency",
          "type": "text",
          "nullable": false
        },
        {
          "name": "source_account_ref",
          "type": "text",
          "nullable": true,
          "description": "Provider-side id of the account the money leaves: a Revolut pocket id, or a Viva source-account IBAN/id. Provider-opaque on purpose."
        },
        {
          "name": "crm_bank_account_id",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "counterparty_name",
          "type": "text",
          "nullable": true
        },
        {
          "name": "reference",
          "type": "text",
          "nullable": true
        },
        {
          "name": "provider_id",
          "type": "text",
          "nullable": true
        },
        {
          "name": "provider_url",
          "type": "text",
          "nullable": true,
          "description": "Payout-link URL, for kind=payout_link"
        },
        {
          "name": "created_by",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "created_at",
          "type": "timestamp with time zone",
          "nullable": false
        },
        {
          "name": "updated_at",
          "type": "timestamp with time zone",
          "nullable": false
        },
        {
          "name": "supplier_bill_id",
          "type": "uuid",
          "nullable": true,
          "description": "The bill this payout pays. Set at instruction time from the dialog that knew it; the reference text is a convenience for the human, never the link."
        },
        {
          "name": "provider",
          "type": "text",
          "nullable": false,
          "enum": [
            "revolut",
            "viva"
          ],
          "description": "Which rail moved the money. Matches finance_bank_accounts.provider_slug."
        },
        {
          "name": "source_bank_account_id",
          "type": "uuid",
          "nullable": true,
          "description": "The account in OUR books the money left, so the instruction and the eventual payment row agree on where it came from."
        }
      ]
    },
