    {
      "name": "payment_allocations",
      "kind": "table",
      "summary": "Which document(s) each payment settled",
      "description": "Links a source (payment, credit note, supplier credit note) to a target (invoice, supplier bill, order, credit release). Read-only through this API. For \"how much is still owed on an order\", call get_order_settlements rather than summing these rows.",
      "docs": "docs/finance-system.md",
      "methods": [
        "GET"
      ],
      "filters": [
        "payment_id",
        "invoice_id",
        "supplier_bill_id",
        "order_id"
