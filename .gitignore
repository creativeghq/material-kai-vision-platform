# deno.lock files generated by ad-hoc `deno check --node-modules-dir=auto` runs.
# The intentional ones (root deno.lock, supabase/functions/agent-chat/deno.lock) are
# already tracked, and gitignore does not affect tracked files.
supabase/functions/deno.lock
supabase/functions/*/deno.lock
!supabase/functions/agent-chat/deno.lock

# #321 embed bundle — built by `npm run build:embed`, never committed (a checked-in build
# artifact drifts from its source the first time someone forgets to rebuild).
public/embed/
edge-prompt-inventory.json
